# Copy this file to deploy/judge0.conf and replace every replace_* value.
# deploy/judge0.conf is ignored by Git.
JUDGE0_TELEMETRY_ENABLE=false
RESTART_MAX_TRIES=10
MAINTENANCE_MODE=false
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
USE_DOCS_AS_HOMEPAGE=false

# Keep one Judge0 execution worker on a small single-server deployment.
COUNT=1
MAX_QUEUE_SIZE=20

AUTHN_HEADER=X-Judge0-Token
AUTHN_TOKEN=replace_with_the_same_token_as_JUDGE0_AUTH_TOKEN
AUTHZ_HEADER=X-Judge0-User
AUTHZ_TOKEN=replace_with_a_separate_authorization_token

REDIS_HOST=judge0-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_judge0_redis_password

POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace_with_a_judge0_postgres_password

CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=5
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=1
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=10
MEMORY_LIMIT=131072
MAX_MEMORY_LIMIT=262144
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=60
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=4096
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false

RAILS_ENV=production
RAILS_MAX_THREADS=2
RAILS_SERVER_PROCESSES=1
SECRET_KEY_BASE=replace_with_a_long_random_secret_key_base
