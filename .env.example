# Application
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
TRUST_PROXY=false

# PostgreSQL (local development values only)
POSTGRES_DB=cppstudy
POSTGRES_USER=cppstudy
POSTGRES_PASSWORD=cppstudy_local_password
DATABASE_URL=postgresql://cppstudy:cppstudy_local_password@127.0.0.1:5432/cppstudy?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Code execution. Keep fake for offline development or use judge0 through an SSH tunnel.
EXECUTION_PROVIDER=fake
WORKER_CONCURRENCY=2
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_HEADER=X-Judge0-Token
JUDGE0_AUTH_TOKEN=replace_with_the_server_authn_token
JUDGE0_CPP17_LANGUAGE_ID=54
JUDGE0_COMPILER_VERSION=C++ (GCC 9.2.0) via Judge0 CE 1.13.1
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_EXECUTION_TIMEOUT_MS=30000
JUDGE0_POLL_INTERVAL_MS=500

# Session
SESSION_COOKIE_NAME=cppstudy_session
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=604800

# Optional local admin seed. Do not commit a real password.
ADMIN_EMAIL=admin@cppstudy.local
ADMIN_NICKNAME=CppStudy 관리자
