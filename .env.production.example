# Public address. Point this domain's A/AAAA record at the server first.
DOMAIN=study.example.com
TLS_EMAIL=owner@example.com
NEXT_PUBLIC_API_URL=/api/v1
# Keep the real file ignored by Git. The example path may be used only for config validation.
JUDGE0_CONFIG_FILE=./deploy/judge0.conf

# Application PostgreSQL. URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=cppstudy
POSTGRES_USER=cppstudy
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://cppstudy:replace_with_a_long_random_password@app-db:5432/cppstudy?schema=public

# Application Redis. URL-encode reserved characters in REDIS_URL.
REDIS_PASSWORD=replace_with_another_long_random_password
REDIS_URL=redis://:replace_with_another_long_random_password@app-redis:6379

# Session and administrator account.
SESSION_COOKIE_NAME=cppstudy_session
SESSION_IDLE_TTL_SECONDS=86400
SESSION_ABSOLUTE_TTL_SECONDS=604800
ADMIN_EMAIL=admin@example.com
ADMIN_NICKNAME=CppStudy 관리자

# This token must exactly match AUTHN_TOKEN in deploy/judge0.conf.
JUDGE0_AUTH_HEADER=X-Judge0-Token
JUDGE0_AUTH_TOKEN=replace_with_a_third_long_random_token
JUDGE0_CPP17_LANGUAGE_ID=54
JUDGE0_COMPILER_VERSION=C++ (GCC 9.2.0) via Judge0 CE 1.13.1
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_EXECUTION_TIMEOUT_MS=30000
JUDGE0_POLL_INTERVAL_MS=500
WORKER_CONCURRENCY=1
